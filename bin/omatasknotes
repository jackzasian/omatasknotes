#!/usr/bin/env python3
"""Read and edit TaskNotes-format tasks in an Obsidian vault.

Kept in the same spirit as m1kode/obsidian-tasks: the QML widget owns
presentation, this owns every touch of the vault. Unlike that plugin's plain
checkbox lines, a TaskNotes task is a whole markdown file with YAML
frontmatter, so a "compare and swap" here is keyed on a hash of the
frontmatter block rather than an exact line -- if the block changed since the
scan that drew a row (Obsidian Sync, or the app itself, rewrote it), the
write is a no-op rather than a guess.

Scope, deliberately: only ever reads/writes inside the vault's configured
TaskNotes folder. Never touches any other note, never re-serialises a whole
frontmatter block (only the one field's own line-range is replaced), and
never evaluates a Bases filter/formula it does not recognise exactly --
unsupported views are reported as such, not silently miscomputed.
"""
import errno
import hashlib
import io
import json
import os
import re
import signal
import stat
import sys
import tempfile
import urllib.request
import urllib.error
import urllib.parse
from datetime import date, datetime, timedelta

try:
    import yaml
except ImportError:
    print(json.dumps({"ok": False, "error": "missing-dependency",
                       "message": "python-yaml is required (install the python-yaml package)"}))
    sys.exit(1)

MAX_SCAN_FILES = 2000        # bound: a runaway/misconfigured vaultPath can't hang the widget
MAX_ROWS = 300               # bound: popup renders at most this many rows
MAX_COMPLETE_INSTANCES = 500 # bound: cap a recurring task's completion history
API_TIMEOUT = 1.5            # seconds -- a hung Obsidian must never hang the widget
# The vault may be shared or synced, so everything read from it is treated as
# untrusted: each file, string and the total output handed to the shell is
# bounded, and the whole run has a deadline.
MAX_NOTE_BYTES = 256 * 1024      # bound: one task note or .base file
MAX_SETTINGS_BYTES = 4 * 1024 * 1024  # bound: TaskNotes' data.json
MAX_BASE_FILES = 200         # bound: .base files read per views listing
MAX_VIEWS = 200              # bound: views offered in the picker
MAX_VIEW_NAME = 200          # views with longer names/ids are skipped, not clipped (the id must round-trip)
MAX_TITLE = 300              # bound: characters of a title shown in a row
MAX_LABEL = 100              # bound: characters of any other displayed string
MAX_OUTPUT = 2 * 1024 * 1024 # bound: bytes of JSON the shell has to buffer and parse
DEADLINE_SEC = 20            # bound: wall-clock time for one helper run

FORBIDDEN_TOKENS = ("file(", "list(", ".filter(", ".map(", ".reduce(",
                    "timeEntries", "&&", "||", "reminders", "googleCalendar")


class Unsupported(Exception):
    """A filter/formula uses a construct we deliberately do not evaluate."""


def eprint(*a):
    print(*a, file=sys.stderr)


def expand(path):
    return os.path.expanduser(path)


def clip(value, limit=MAX_LABEL):
    s = "" if value is None else str(value)
    return s if len(s) <= limit else s[:limit - 1] + "…"


def read_text(path, limit=MAX_NOTE_BYTES):
    """Read a regular file of at most `limit` bytes as UTF-8, else OSError.

    Refuses symlinks (O_NOFOLLOW) and anything that isn't a regular file
    (FIFOs, devices, sockets) without blocking on it (O_NONBLOCK), so a
    planted `x.md -> /dev/zero` or a named pipe can't hang or exhaust the
    helper.
    """
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            raise OSError(errno.EINVAL, "not a regular file", path)
        if st.st_size > limit:
            raise OSError(errno.EFBIG, "file too large", path)
        chunks, total = [], 0
        while total <= limit:
            chunk = os.read(fd, min(65536, limit + 1 - total))
            if not chunk:
                break
            chunks.append(chunk)
            total += len(chunk)
        if total > limit:
            raise OSError(errno.EFBIG, "file too large", path)
    finally:
        os.close(fd)
    try:
        return b"".join(chunks).decode("utf-8")
    except UnicodeDecodeError:
        raise OSError(errno.EILSEQ, "not valid UTF-8", path)


class _NoAliasLoader(yaml.SafeLoader):
    """SafeLoader that rejects YAML aliases.

    Aliases are shared references while parsed, but every consumer here
    (json.dumps, the filter evaluator) walks them out in full, so a nested
    alias "billion laughs" block would expand exponentially. Nothing
    TaskNotes or Bases writes uses them.
    """

    def compose_node(self, parent, index):
        if self.check_event(yaml.AliasEvent):
            raise yaml.YAMLError("YAML aliases are not supported")
        return super().compose_node(parent, index)


def load_yaml(text):
    return yaml.load(text, Loader=_NoAliasLoader)


# ---------------------------------------------------------------- vault ----

def resolve_vault(hint):
    hint = expand(hint.strip()) if hint else ""
    if hint:
        return {"path": hint, "source": "setting", "exists": os.path.isdir(hint)}
    registries = [
        expand("~/.config/obsidian/obsidian.json"),
        expand("~/.var/app/md.obsidian.Obsidian/config/obsidian/obsidian.json"),
        expand("~/snap/obsidian/current/.config/obsidian/obsidian.json"),
    ]
    for reg in registries:
        try:
            with open(reg, "r", encoding="utf-8") as f:
                data = json.load(f)
        except (OSError, ValueError):
            continue
        vaults = data.get("vaults", {})
        best = None
        for v in vaults.values():
            if not isinstance(v, dict) or not v.get("path"):
                continue
            if best is None or v.get("ts", 0) > best.get("ts", 0):
                best = v
        if best:
            return {"path": best["path"], "source": "obsidian", "exists": os.path.isdir(best["path"])}
    return {"path": "", "source": "none", "exists": False}


def tasknotes_settings(vault_path):
    cfg_path = os.path.join(vault_path, ".obsidian", "plugins", "tasknotes", "data.json")
    try:
        data = json.loads(read_text(cfg_path, MAX_SETTINGS_BYTES))
    except (OSError, ValueError):
        return None
    return data if isinstance(data, dict) else None


# ----------------------------------------------------------- frontmatter ---

FM_DELIM = re.compile(r"^---\s*$")


def split_frontmatter(text):
    """Return (fm_lines, body_text, fm_raw) or None if there's no frontmatter."""
    lines = text.split("\n")
    if not lines or not FM_DELIM.match(lines[0]):
        return None
    for i in range(1, len(lines)):
        if FM_DELIM.match(lines[i]):
            fm_lines = lines[1:i]
            body = "\n".join(lines[i + 1:])
            fm_raw = "\n".join(fm_lines)
            return fm_lines, body, fm_raw
    return None


def fm_hash(fm_raw):
    return hashlib.sha256(fm_raw.encode("utf-8")).hexdigest()


def parse_frontmatter(fm_lines):
    try:
        data = load_yaml("\n".join(fm_lines))
    except yaml.YAMLError:
        return {}
    return data if isinstance(data, dict) else {}


def field_blocks(fm_lines):
    """Split frontmatter lines into (key, [lines]) blocks, preserving order and
    original text exactly. A block runs from a top-level "key:" line up to
    (not including) the next top-level key line."""
    blocks = []
    current_key = None
    current_lines = []
    key_re = re.compile(r"^([A-Za-z0-9_.\-]+):")
    for line in fm_lines:
        m = key_re.match(line) if line and not line[0].isspace() else None
        if m:
            if current_key is not None:
                blocks.append((current_key, current_lines))
            current_key = m.group(1)
            current_lines = [line]
        else:
            if current_key is None:
                continue  # stray line before any key (comment/blank) -- drop, never seen in practice
            current_lines.append(line)
    if current_key is not None:
        blocks.append((current_key, current_lines))
    return blocks


def blocks_to_text(blocks):
    out = []
    for _key, lines in blocks:
        out.extend(lines)
    return "\n".join(out)


DOC_END_MARKER_RE = re.compile(r"\n\.\.\.\s*$")


def yaml_scalar_line(key, value):
    # Dump only the value in flow style, then attach the key ourselves --
    # dumping {key: value} directly would flow-style the *mapping* too,
    # wrapping the whole line in braces instead of producing "key: value".
    value_text = yaml.safe_dump(value, default_flow_style=True, allow_unicode=True)
    # PyYAML appends an explicit "...\n" document-end marker whenever the
    # top-level dumped node is a bare scalar (never for a list/dict) --
    # left in, it becomes a second, corrupting line in the frontmatter
    # block instead of staying part of this one field's value.
    value_text = DOC_END_MARKER_RE.sub("", value_text).strip()
    return "%s: %s" % (key, value_text)


def set_field(blocks, key, value):
    """Return a new blocks list with `key` set to `value` (single-line, flow
    style). Replaces the block if present, else appends a new one."""
    new_line = yaml_scalar_line(key, value)
    out = []
    replaced = False
    for k, lines in blocks:
        if k == key:
            out.append((k, [new_line]))
            replaced = True
        else:
            out.append((k, lines))
    if not replaced:
        out.append((key, [new_line]))
    return out


def remove_field(blocks, key):
    return [(k, lines) for k, lines in blocks if k != key]


def now_ts():
    """TaskNotes' timestamp format: local, 3 fractional digits, +HH:MM."""
    return datetime.now().astimezone().isoformat(timespec="milliseconds")


# ----------------------------------------------------------- recurrence ----
# TaskNotes semantics (rrule.js in floating time, compared as calendar
# dates), ported from OmaForge's core/omaforge/recurrence.py.
#
# RRULE expansion is done here rather than with python-dateutil, which a
# standard Omarchy install doesn't ship. It covers the RFC 5545 parts
# TaskNotes' recurrence editor produces (FREQ DAILY..YEARLY, INTERVAL,
# COUNT, UNTIL, BYDAY, BYMONTHDAY, BYMONTH, BYSETPOS, WKST), following
# dateutil's expansion rules exactly, and refuses the rest (BYHOUR,
# BYYEARDAY, BYWEEKNO, sub-daily FREQ, ...) rather than guessing.

DTSTART_RE = re.compile(r"DTSTART:(\d{8}(?:T\d{6}Z?)?)")
WEEKDAYS = ("MO", "TU", "WE", "TH", "FR", "SA", "SU")
BYDAY_RE = re.compile(r"^([+-]?\d{1,2})?(MO|TU|WE|TH|FR|SA|SU)$")
RRULE_PARTS = {"FREQ", "INTERVAL", "COUNT", "UNTIL", "BYDAY", "BYMONTHDAY", "BYMONTH",
               "BYSETPOS", "WKST"}
RRULE_UNSUPPORTED = {"BYSECOND", "BYMINUTE", "BYHOUR", "BYYEARDAY", "BYWEEKNO", "BYEASTER"}
MAX_RRULE_PERIODS = 100000   # bound: periods walked per expansion


def _int_list(value, lo, hi):
    out = []
    for item in value.split(","):
        n = int(item)
        if not (lo <= abs(n) <= hi) or (lo > 0 and n == 0):
            raise ValueError("value out of range: %r" % item)
        out.append(n)
    return out


class _RRule:
    """One RRULE in floating time; `between` mirrors dateutil.rrule's."""

    def __init__(self, parts, start):
        for key in parts:
            if key in RRULE_UNSUPPORTED:
                raise Unsupported("repeat rule uses %s, which isn't supported" % key)
            if key not in RRULE_PARTS:
                raise ValueError("unknown RRULE part %r" % key)
        freq = parts["FREQ"].upper()
        if freq in ("HOURLY", "MINUTELY", "SECONDLY"):
            raise Unsupported("repeat rule FREQ=%s isn't supported" % freq)
        if freq not in ("DAILY", "WEEKLY", "MONTHLY", "YEARLY"):
            raise ValueError("bad FREQ %r" % freq)
        self.freq, self.start = freq, start
        self.interval = int(parts.get("INTERVAL", "1"))
        if self.interval < 1:
            raise ValueError("INTERVAL must be positive")
        self.count = int(parts["COUNT"]) if "COUNT" in parts else None
        self.until = None
        if "UNTIL" in parts:
            u = parts["UNTIL"].upper().rstrip("Z")
            self.until = datetime.strptime(u, "%Y%m%dT%H%M%S" if "T" in u else "%Y%m%d")
        self.wkst = WEEKDAYS.index(parts.get("WKST", "MO").upper())
        self.bymonth = _int_list(parts["BYMONTH"], 1, 12) if "BYMONTH" in parts else []
        if any(m < 0 for m in self.bymonth):
            raise ValueError("BYMONTH must be positive")
        self.bymonthday = _int_list(parts["BYMONTHDAY"], 1, 31) if "BYMONTHDAY" in parts else []
        self.bysetpos = _int_list(parts["BYSETPOS"], 1, 366) if "BYSETPOS" in parts else []
        self.byweekday, self.bynweekday = set(), []
        for item in parts["BYDAY"].upper().split(",") if "BYDAY" in parts else []:
            m = BYDAY_RE.match(item.strip())
            if not m:
                raise ValueError("bad BYDAY %r" % item)
            wd = WEEKDAYS.index(m.group(2))
            n = int(m.group(1)) if m.group(1) else 0
            if n == 0:
                self.byweekday.add(wd)
            elif freq in ("DAILY", "WEEKLY"):
                raise Unsupported("repeat rule uses a numbered BYDAY with FREQ=%s" % freq)
            elif not 1 <= abs(n) <= 53:
                raise ValueError("bad BYDAY %r" % item)
            else:
                self.bynweekday.append((wd, n))
        # dateutil's defaults when no day-selecting part is given.
        if not (self.bymonthday or self.byweekday or self.bynweekday):
            if freq == "YEARLY":
                self.bymonth = self.bymonth or [start.month]
                self.bymonthday = [start.day]
            elif freq == "MONTHLY":
                self.bymonthday = [start.day]
            elif freq == "WEEKLY":
                self.byweekday = {start.weekday()}

    def _period_days(self, k):
        """Every day of the k-th period, before any BYxxx filtering."""
        s, step = self.start.date(), self.interval * k
        if self.freq == "DAILY":
            return [s + timedelta(days=step)]
        if self.freq == "WEEKLY":
            ws = s - timedelta(days=(s.weekday() - self.wkst) % 7) + timedelta(weeks=step)
            # The first week starts at DTSTART, not at WKST -- which matters
            # to BYSETPOS. dateutil and rrule.js (what TaskNotes uses) agree.
            return [ws + timedelta(days=i) for i in range(7) if k or ws + timedelta(days=i) >= s]
        if self.freq == "MONTHLY":
            y, m = divmod(s.year * 12 + s.month - 1 + step, 12)
            first, months = date(y, m + 1, 1), 1
        else:
            first, months = date(s.year + step, 1, 1), 12
        y2, m2 = divmod(first.year * 12 + first.month - 1 + months, 12)
        return [first + timedelta(days=i) for i in range((date(y2, m2 + 1, 1) - first).days)]

    def _nth_ok(self, d, days):
        # Numbered BYDAY counts within the month, except YEARLY without
        # BYMONTH, which counts within the year (as dateutil does).
        if self.freq == "YEARLY" and not self.bymonth:
            scope = [x for x in days if x.weekday() == d.weekday()]
        else:
            scope = [x for x in days if x.month == d.month and x.weekday() == d.weekday()]
        pos = scope.index(d)
        return any(wd == d.weekday() and (n - 1 == pos if n > 0 else len(scope) + n == pos)
                   for wd, n in self.bynweekday)

    def _matches(self, d, days):
        if self.bymonth and d.month not in self.bymonth:
            return False
        if self.bymonthday:
            last = (date(d.year + d.month // 12, d.month % 12 + 1, 1) - timedelta(days=1)).day
            if not any(d.day == (n if n > 0 else last + 1 + n) for n in self.bymonthday):
                return False
        # Plain and numbered weekdays are separate filters that must both
        # pass (so mixing them narrows, not widens) -- dateutil and rrule.js.
        if self.byweekday and d.weekday() not in self.byweekday:
            return False
        if self.bynweekday and not self._nth_ok(d, days):
            return False
        return True

    def _iter(self, stop):
        t, emitted = self.start.time(), 0
        for k in range(MAX_RRULE_PERIODS):
            try:
                days = self._period_days(k)
            except (ValueError, OverflowError):
                return  # ran off the end of the calendar
            if days[0] > stop.date():
                return  # every later period starts later still
            chosen = [d for d in days if self._matches(d, days)]
            if self.bysetpos:
                chosen = sorted({chosen[p - 1 if p > 0 else len(chosen) + p]
                                 for p in self.bysetpos if -len(chosen) <= p <= len(chosen) and p != 0})
            for d in chosen:
                o = datetime.combine(d, t)
                if o < self.start:
                    continue
                if (self.until is not None and o > self.until) or \
                        (self.count is not None and emitted >= self.count):
                    return
                yield o
                emitted += 1
        raise Unsupported("repeat rule spans too many periods to expand")

    def between(self, lo, hi, inc=True):
        out = []
        for o in self._iter(hi):
            if o > hi or (not inc and o == hi):
                break
            if o > lo or (inc and o == lo):
                out.append(o)
        return out


def _rrule(rule, fallback_start):
    rule = str(rule or "").strip()
    m = DTSTART_RE.search(rule)
    start = None
    if m:
        for fmt in ("%Y%m%dT%H%M%SZ", "%Y%m%dT%H%M%S", "%Y%m%d"):
            try:
                start = datetime.strptime(m.group(1), fmt)
                break
            except ValueError:
                pass
    body = re.sub(r"DTSTART:[^;]+;?", "", rule).strip().lstrip(";")
    if body.upper().startswith("RRULE:"):
        body = body[6:]
    parts = dict(c.split("=", 1) for c in body.split(";") if "=" in c)
    parts = {k.strip().upper(): v.strip() for k, v in parts.items()}
    if "FREQ" not in parts:
        return None, None, parts
    if start is None:
        if fallback_start is None:
            return None, None, parts
        start = datetime(fallback_start.year, fallback_start.month, fallback_start.day)
    body = re.sub(r"UNTIL=([0-9TZ]+)",
                  lambda u: "UNTIL=" + (u.group(1) + "T000000" if len(u.group(1)) == 8 else u.group(1)).rstrip("Z"),
                  body)
    try:
        return _RRule(parts, start), start, parts
    except (ValueError, TypeError):
        return None, None, parts


def _lookahead(parts):
    try:
        i = max(1, int(parts.get("INTERVAL", "1")))
    except ValueError:
        i = 1
    return {"DAILY": max(30, 2 * i), "WEEKLY": max(90, 14 * i), "MONTHLY": max(400, 62 * i),
            "YEARLY": max(800, 732 * i)}.get(parts.get("FREQ"), 365)


def _occurrences(r, start_day, end_day):
    lo = datetime(start_day.year, start_day.month, start_day.day)
    hi = datetime(end_day.year, end_day.month, end_day.day, 23, 59, 59)
    return [o.date() for o in r.between(lo, hi, inc=True)]


def recurring_instance(rule, target, completed, skipped, anchor, fallback_start):
    """Which occurrence a tick on `target` completes (TaskNotes §4.4)."""
    t = date.fromisoformat(target)
    if anchor == "completion":
        return target
    r, _start, parts = _rrule(rule, fallback_start)
    if r is None or _occurrences(r, t, t):
        return target
    processed = set(completed) | set(skipped)
    for o in reversed(_occurrences(r, t - timedelta(days=_lookahead(parts)), t)):
        if o.isoformat() not in processed:
            return o.isoformat()
    for o in _occurrences(r, t, t + timedelta(days=_lookahead(parts))):
        if o.isoformat() not in set(completed):
            return o.isoformat()
    return target


def next_open_occurrence(rule, floor, completed, skipped, anchor, fallback_start):
    """First occurrence >= floor neither completed nor skipped (§4.5)."""
    f = date.fromisoformat(floor)
    r, start, parts = _rrule(rule, fallback_start or f)
    if r is None:
        return None
    sd = start.date()
    if anchor == "completion":
        for o in _occurrences(r, sd, sd + timedelta(days=_lookahead(parts))):
            if o > sd and o >= f and o.isoformat() not in set(skipped):
                return o.isoformat()
        return None
    lo = sd if sd < f else f
    processed = set(completed) | set(skipped)
    for o in _occurrences(r, lo, f + timedelta(days=_lookahead(parts))):
        if o >= f and o.isoformat() not in processed:
            return o.isoformat()
    return None


def atomic_write(path, content):
    directory = os.path.dirname(path) or "."
    try:
        orig_mode = stat.S_IMODE(os.stat(path).st_mode)
    except OSError:
        orig_mode = 0o644
    fd, tmp_path = tempfile.mkstemp(prefix=".omatasknotes-", suffix=".tmp", dir=directory)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(content)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp_path, orig_mode)
        os.replace(tmp_path, path)
    except Exception:
        try:
            os.unlink(tmp_path)
        except OSError:
            pass
        raise


def safe_join(vault_path, rel_path):
    """Resolve rel_path under vault_path, refusing any escape attempt."""
    full = os.path.realpath(os.path.join(vault_path, rel_path))
    root = os.path.realpath(vault_path)
    if full != root and not full.startswith(root + os.sep):
        raise ValueError("path escapes vault: %r" % rel_path)
    return full


# ------------------------------------------------------------- tag scan ----

INLINE_TAG_RE = re.compile(r"(?<!\S)#([A-Za-z0-9_/-]+)")


def note_tags(fm, body):
    tags = set()
    raw = fm.get("tags")
    if isinstance(raw, str):
        tags.add(raw.lstrip("#"))
    elif isinstance(raw, list):
        for t in raw:
            if isinstance(t, str):
                tags.add(t.lstrip("#"))
    for m in INLINE_TAG_RE.finditer(body or ""):
        tags.add(m.group(1))
    return tags


# --------------------------------------------------------- status/prio ----

def status_lookup(settings):
    by_value = {}
    for s in settings.get("customStatuses") or []:
        by_value[s.get("value")] = s
    return by_value


def priority_lookup(settings):
    by_value = {}
    for p in settings.get("customPriorities") or []:
        by_value[p.get("value")] = p
    return by_value


def first_completed_status(settings):
    statuses = sorted(settings.get("customStatuses") or [], key=lambda s: s.get("order", 0))
    for s in statuses:
        if s.get("isCompleted"):
            return s.get("value")
    return "done"


def is_completed_status(settings, value):
    for s in settings.get("customStatuses") or []:
        if s.get("value") == value:
            return bool(s.get("isCompleted"))
    return False


def first_open_status(settings):
    statuses = sorted(settings.get("customStatuses") or [], key=lambda s: s.get("order", 0))
    for s in statuses:
        if not s.get("isCompleted"):
            return s.get("value")
    return settings.get("defaultTaskStatus", "todo")


# --------------------------------------------------------------- dates -----

def parse_date(value):
    """Best-effort parse of a due/scheduled value into a date(), or None.

    PyYAML auto-converts an unquoted YYYY-MM-DD (or full ISO timestamp)
    scalar into a real date/datetime object, and every real task file in
    this vault writes dates unquoted -- so a plain string is only one of
    the shapes this can arrive in, not the common one.
    """
    if value is None:
        return None
    if isinstance(value, datetime):
        return value.date()
    if isinstance(value, date):
        return value
    if not isinstance(value, str):
        return None
    m = re.match(r"^(\d{4})-(\d{2})-(\d{2})", value)
    if not m:
        return None
    try:
        return date(int(m.group(1)), int(m.group(2)), int(m.group(3)))
    except ValueError:
        return None


def date_str(value):
    """Stringify a due/scheduled value for JSON output. PyYAML turns an
    unquoted date/datetime scalar into a real date/datetime object, and
    those aren't JSON-serialisable -- passing one through to json.dumps()
    untouched would crash the scan on the first task that has one."""
    if value is None:
        return ""
    if isinstance(value, (date, datetime)):
        return value.isoformat()
    return str(value)


def today_str():
    return date.today().isoformat()


# ---------------------------------------------------------- row model ------

def build_row(rel_path, fm, body, fm_raw):
    return {
        "file": rel_path,
        "fm": fm,
        "tags": note_tags(fm, body),
        "hash": fm_hash(fm_raw),
    }


# A row with no data, used only to classify a leaf expression (does it match
# a recognised shape at all?) without needing real field values -- the
# regexes in eval_leaf don't inspect row content to decide whether an
# expression is *recognised*, only to decide its boolean result once it is.
DUMMY_ROW = build_row("", {}, "", "")


def field(row, key):
    return row["fm"].get(key)


def is_empty(v):
    if v is None:
        return True
    if isinstance(v, str):
        return v.strip() == ""
    if isinstance(v, (list, dict)):
        return len(v) == 0
    return False


def truthy(v):
    return not is_empty(v) and v is not False


# ---------------------------------------------------- leaf expression ------

DATE_CMP_RE = re.compile(
    r'^date\((\w+)\)\s*(==|!=|<=|>=|<|>)\s*today\(\)\s*(?:\+\s*"(\d+)\s*(?:d|days)?"\s*)?$')
DATE_DOT_TODAY_RE = re.compile(r'^date\((\w+)\)\.date\(\)\s*==\s*today\(\)$')
DATE_EMPTY_RE = re.compile(r'^date\((\w+)\)\.isEmpty\(\)$')
FIELD_EMPTY_RE = re.compile(r'^([A-Za-z0-9_]+)\.isEmpty\(\)$')
HAS_TAG_RE = re.compile(r'^file\.hasTag\(\s*"([^"]+)"\s*\)$')
CONTAINS_TODAY_RE = re.compile(
    r'^([A-Za-z0-9_]+)\.contains\(\s*today\(\)\.format\(\s*"[^"]*"\s*\)\s*\)$')
EQ_RE = re.compile(r'^([A-Za-z0-9_.]+)\s*(==|!=)\s*"([^"]*)"$')
BARE_FIELD_RE = re.compile(r'^([A-Za-z0-9_]+)$')


def eval_leaf(expr, row):
    expr = expr.strip()
    negate = False
    if expr.startswith("!"):
        negate = True
        expr = expr[1:].strip()

    for token in FORBIDDEN_TOKENS:
        if token in expr:
            raise Unsupported("unsupported construct in %r" % expr)

    result = None
    m = HAS_TAG_RE.match(expr)
    if m:
        result = m.group(1) in row["tags"]

    if result is None:
        m = CONTAINS_TODAY_RE.match(expr)
        if m:
            v = field(row, m.group(1))
            items = v if isinstance(v, list) else []
            result = today_str() in [str(x) for x in items]

    if result is None:
        m = FIELD_EMPTY_RE.match(expr)
        if m:
            result = is_empty(field(row, m.group(1)))

    if result is None:
        m = DATE_EMPTY_RE.match(expr)
        if m:
            result = parse_date(field(row, m.group(1))) is None

    if result is None:
        m = DATE_DOT_TODAY_RE.match(expr)
        if m:
            d = parse_date(field(row, m.group(1)))
            result = d is not None and d == date.today()

    if result is None:
        m = DATE_CMP_RE.match(expr)
        if m:
            fname, op, n_days = m.group(1), m.group(2), m.group(3)
            d = parse_date(field(row, fname))
            if d is None:
                result = False
            else:
                target = date.today()
                if n_days:
                    target = target + timedelta(days=int(n_days))
                result = {
                    "==": d == target, "!=": d != target,
                    "<": d < target, "<=": d <= target,
                    ">": d > target, ">=": d >= target,
                }[op]

    if result is None:
        m = EQ_RE.match(expr)
        if m:
            fname, op, val = m.group(1), m.group(2), m.group(3)
            actual = field(row, fname)
            actual_s = "" if actual is None else str(actual)
            result = (actual_s == val) if op == "==" else (actual_s != val)

    if result is None:
        m = BARE_FIELD_RE.match(expr)
        if m:
            result = truthy(field(row, m.group(1)))

    if result is None:
        raise Unsupported("unrecognised expression: %r" % expr)

    return (not result) if negate else result


def eval_tree(node, row):
    """node is a YAML-parsed filter tree: {"and":[...]} / {"or":[...]} / a
    leaf string. Raises Unsupported if anything in it can't be evaluated.

    Real evaluation only -- and/or short-circuit here on purpose. Never use
    this to decide whether a view is *safe*: a short-circuited branch is
    never visited, so an unsupported construct behind an early False/True
    would slip through undetected. Use validate_tree for that."""
    if isinstance(node, str):
        return eval_leaf(node, row)
    if isinstance(node, dict):
        if "and" in node:
            return all(eval_tree(child, row) for child in node["and"])
        if "or" in node:
            return any(eval_tree(child, row) for child in node["or"])
        raise Unsupported("unrecognised filter node: %r" % node)
    raise Unsupported("unrecognised filter node: %r" % node)


def validate_tree(node):
    """Visit every leaf unconditionally (no short-circuiting) and raise
    Unsupported if any of them can't be safely evaluated. This is the only
    correct way to decide whether a view is safe -- eval_tree's and/or use
    real short-circuiting, which would skip checking a later leaf entirely
    whenever an earlier one in the same and/or already decided the result."""
    if isinstance(node, str):
        eval_leaf(node, DUMMY_ROW)
        return
    if isinstance(node, dict):
        if "and" in node:
            for child in node["and"]:
                validate_tree(child)
            return
        if "or" in node:
            for child in node["or"]:
                validate_tree(child)
            return
        raise Unsupported("unrecognised filter node: %r" % node)
    raise Unsupported("unrecognised filter node: %r" % node)


# ----------------------------------------------------- known formulas ------

KNOWN_FORMULAS = {
    "priorityWeight": lambda row, settings: priority_weight(row, settings),
    "daysUntilDue": lambda row, settings: days_until(field(row, "due")),
    "daysUntilScheduled": lambda row, settings: days_until(field(row, "scheduled")),
    "isOverdue": lambda row, settings: (
        parse_date(field(row, "due")) is not None
        and parse_date(field(row, "due")) < date.today()
        and str(field(row, "status")) != "done"),
    "isDueToday": lambda row, settings: parse_date(field(row, "due")) == date.today(),
    "isDueThisWeek": lambda row, settings: _due_this_week(row),
    "isScheduledToday": lambda row, settings: parse_date(field(row, "scheduled")) == date.today(),
    "isRecurring": lambda row, settings: truthy(field(row, "recurrence")),
    "daysUntilNext": lambda row, settings: days_until_next(row),
    "urgencyScore": lambda row, settings: urgency_score(row, settings),
}


# These are expression contracts, not formula-name aliases. A customised
# expression must never silently inherit the default formula's behaviour.
KNOWN_FORMULA_EXPRESSIONS = {
    "priorityWeight": 'if(priority=="none",0,if(priority=="low",1,if(priority=="normal",2,if(priority=="high",3,999))))',
    "daysUntilDue": 'if(due, ((number(date(due)) - number(today())) / 86400000).floor(), null)',
    "daysUntilScheduled": 'if(scheduled, ((number(date(scheduled)) - number(today())) / 86400000).floor(), null)',
    "isOverdue": 'due && date(due) < today() && status != "done"',
    "isDueToday": 'due && date(due).date() == today()',
    "isDueThisWeek": 'due && date(due) >= today() && date(due) <= today() + "7d"',
    "isScheduledToday": 'scheduled && date(scheduled).date() == today()',
    "isRecurring": 'recurrence && !recurrence.isEmpty()',
    "daysUntilNext": 'if(due && scheduled, min(formula.daysUntilDue, formula.daysUntilScheduled), if(due, formula.daysUntilDue, formula.daysUntilScheduled))',
    "urgencyScore": 'if(!due && !scheduled, formula.priorityWeight, formula.priorityWeight + max(0, 10 - formula.daysUntilNext))',
}


def priority_weight(row, settings):
    # Match the validated Base expression, which may differ from UI weights.
    return {"none": 0, "low": 1, "normal": 2, "high": 3}.get(field(row, "priority"), 999)


def days_until(value):
    d = parse_date(value)
    if d is None:
        return None
    return (d - date.today()).days


def _due_this_week(row):
    d = parse_date(field(row, "due"))
    if d is None:
        return False
    today = date.today()
    return today <= d <= today + timedelta(days=7)


def days_until_next(row):
    dd = days_until(field(row, "due"))
    ds = days_until(field(row, "scheduled"))
    if dd is not None and ds is not None:
        return min(dd, ds)
    return dd if dd is not None else ds


def urgency_score(row, settings):
    pw = priority_weight(row, settings)
    dn = days_until_next(row)
    if dn is None:
        return pw
    return pw + max(0, 10 - dn)


def resolve_sort_key(name, formulas):
    if name.startswith("formula."):
        fname = name[len("formula."):]
        if fname not in KNOWN_FORMULAS:
            raise Unsupported("unrecognised formula: %r" % name)
        expected = KNOWN_FORMULA_EXPRESSIONS[fname]
        if formulas.get(fname) != expected:
            raise Unsupported("custom or missing formula: %r" % name)
        for dependency in re.findall(r"formula\.([A-Za-z0-9_]+)", expected):
            resolve_sort_key("formula." + dependency, formulas)
        return ("formula", fname)
    return ("field", name)


def sort_value(row, settings, key):
    kind, name = key
    if kind == "formula":
        return KNOWN_FORMULAS[name](row, settings)
    if name == "tasknotes_manual_order":
        return 0
    v = field(row, name)
    if v is None:
        return ""
    return v


# ------------------------------------------------------- view discovery ----

def list_base_views(vault_path, views_dir_rel="TaskNotes/Views"):
    views_dir = os.path.join(vault_path, views_dir_rel)
    out = []
    if not os.path.isdir(views_dir):
        return out
    try:
        entries = sorted(os.listdir(views_dir))
    except OSError:
        return out
    entries = [name for name in entries if name.endswith(".base")][:MAX_BASE_FILES]
    for name in entries:
        rel = os.path.join(views_dir_rel, name)
        full = os.path.join(views_dir, name)
        try:
            doc = load_yaml(read_text(full))
        except (OSError, yaml.YAMLError):
            continue
        if not isinstance(doc, dict):
            continue
        top_filters = doc.get("filters")
        views = doc.get("views")
        for v in views if isinstance(views, list) else []:
            if not isinstance(v, dict):
                continue
            vname = str(v.get("name") or "(unnamed)")
            vtype = v.get("type", "")
            key = "base:%s::%s" % (rel, vname)
            supported = True
            reason = ""
            if vtype not in ("tasknotesTaskList",):
                supported, reason = False, "view type %r not shown in a list popup" % vtype
            filters = v.get("filters", top_filters)
            if top_filters is not None and v.get("filters") is not None:
                filters = {"and": [top_filters, v["filters"]]}
            formulas = doc.get("formulas") or {}
            try:
                if supported and filters is not None:
                    # validate_tree, never eval_tree: this must visit every
                    # leaf regardless of and/or short-circuiting, or a bad
                    # construct hiding behind an already-decided branch would
                    # go undetected (see validate_tree's docstring).
                    validate_tree(filters)
            except Unsupported as e:
                supported, reason = False, str(e)
            for sort_entry in v.get("sort") or []:
                if not supported:
                    break
                try:
                    resolve_sort_key(sort_entry.get("property", ""), formulas)
                except Unsupported as e:
                    supported, reason = False, str(e)
            out.append({
                "id": key, "name": vname, "source": rel,
                "kind": "base", "supported": supported, "reason": reason,
                "_filters": filters, "_sort": v.get("sort") or [], "_formulas": formulas,
            })
    return out


def list_saved_views(settings):
    out = []
    saved = settings.get("savedViews")
    for sv in saved if isinstance(saved, list) else []:
        if not isinstance(sv, dict):
            continue
        out.append({
            "id": "saved:%s" % sv.get("id"), "name": str(sv.get("name") or "(unnamed)"),
            "source": "TaskNotes settings", "kind": "saved",
            "supported": True, "reason": "",
            "_query": sv.get("query") or {},
        })
    return out


SAVED_OP_MAP = {
    "is": lambda a, v: str(a) == str(v),
    "is-not": lambda a, v: str(a) != str(v),
    "contains": lambda a, v: str(v) in (a if isinstance(a, list) else [a]) or str(v) in str(a or ""),
    "does-not-contain": lambda a, v: not (str(v) in (a if isinstance(a, list) else [a]) or str(v) in str(a or "")),
    "is-empty": lambda a, v: is_empty(a),
    "is-not-empty": lambda a, v: not is_empty(a),
    "is-checked": lambda a, v: truthy(a),
    "is-not-checked": lambda a, v: not truthy(a),
    "is-before": lambda a, v: (parse_date(a) or date.max) < (parse_date(v) or date.min),
    "is-after": lambda a, v: (parse_date(a) or date.min) > (parse_date(v) or date.max),
    "is-on-or-before": lambda a, v: (parse_date(a) or date.max) <= (parse_date(v) or date.min),
    "is-on-or-after": lambda a, v: (parse_date(a) or date.min) >= (parse_date(v) or date.max),
}


def eval_saved_condition(cond, row, archive_tag):
    prop = cond.get("property", "")
    op = cond.get("operator", "")
    val = cond.get("value")
    fn = SAVED_OP_MAP.get(op)
    if fn is None:
        raise Unsupported("unsupported saved-view operator: %r" % op)
    actual = (archive_tag in row["tags"]) if prop == "archived" else field(row, prop)
    return fn(actual, val)


def eval_saved_query(node, row, archive_tag):
    if node.get("type") == "condition":
        return eval_saved_condition(node, row, archive_tag)
    if node.get("type") == "group":
        children = node.get("children") or []
        conj = node.get("conjunction", "and")
        results = [eval_saved_query(c, row, archive_tag) for c in children]
        return all(results) if conj == "and" else any(results)
    raise Unsupported("unrecognised saved-view node")


# ----------------------------------------------------------------- scan ----

def iter_task_files(tasks_dir):
    count = 0
    for root, dirs, files in os.walk(tasks_dir):
        dirs[:] = [d for d in dirs if not d.startswith(".")]
        for name in sorted(files):
            if not name.endswith(".md"):
                continue
            count += 1
            if count > MAX_SCAN_FILES:
                return
            yield os.path.join(root, name)


def load_task(vault_path, full_path):
    try:
        text = read_text(full_path)
    except OSError:
        return None
    split = split_frontmatter(text)
    if not split:
        return None
    fm_lines, body, fm_raw = split
    fm = parse_frontmatter(fm_lines)
    rel = os.path.relpath(full_path, vault_path)
    return build_row(rel, fm, body, fm_raw)


def title_of(row, tasks_dir_rel):
    t = row["fm"].get("title")
    if isinstance(t, str) and t.strip():
        return t
    base = os.path.basename(row["file"])
    return re.sub(r"\.md$", "", base)


def cmd_scan(vault_path, view_id):
    settings = tasknotes_settings(vault_path)
    if settings is None:
        print(json.dumps({"ok": False, "error": "no-tasknotes",
                           "message": "TaskNotes plugin config not found in this vault"}))
        return
    tag = settings.get("taskTag", "todo")
    tasks_dir_rel = settings.get("tasksFolder", "TaskNotes/Tasks")
    tasks_dir = safe_join(vault_path, tasks_dir_rel)
    if not os.path.isdir(tasks_dir):
        print(json.dumps({"ok": False, "error": "no-folder",
                           "message": "tasksFolder %r not found" % clip(tasks_dir_rel)}))
        return

    views = list_base_views(vault_path) + list_saved_views(settings)
    view = next((v for v in views if v["id"] == view_id), None)
    if view is None or not view["supported"]:
        print(json.dumps({"ok": False, "error": "unsupported-view",
                           "message": "view not found or unsupported"}))
        return

    rows = []
    for full in iter_task_files(tasks_dir):
        row = load_task(vault_path, full)
        if row is None or tag not in row["tags"]:
            continue
        try:
            if view["kind"] == "base":
                filters = view.get("_filters")
                if filters is not None and not eval_tree(filters, row):
                    continue
            else:
                query = view.get("_query", {})
                archive_tag = (settings.get("fieldMapping") or {}).get("archiveTag", "archived")
                if query and not eval_saved_query(query, row, archive_tag):
                    continue
        except Unsupported:
            # Shouldn't happen (dry-run already checked), but never crash the
            # scan over one bad row -- skip it defensively instead.
            continue
        rows.append(row)

    statuses = status_lookup(settings)
    priorities = priority_lookup(settings)

    def sort_key(row):
        if view["kind"] == "base":
            keys = []
            for entry in view.get("_sort") or []:
                try:
                    k = resolve_sort_key(entry.get("property", ""), view.get("_formulas", {}))
                except Unsupported:
                    continue
                v = sort_value(row, settings, k)
                rev = entry.get("direction") == "DESC"
                keys.append((v, rev))
            return keys
        return [(title_of(row, tasks_dir_rel), False)]

    def cmp_rows(row):
        # Python sort needs plain orderable keys; DESC handled by negating
        # numeric values where possible, else by reversing string compare
        # via a wrapper. Numbers dominate here (formula/due sorts), so this
        # covers the real shipped views; ties fall back to title.
        parts = []
        for v, rev in sort_key(row):
            if isinstance(v, (int, float)):
                parts.append(-v if rev else v)
            else:
                parts.append(str(v))
        parts.append(title_of(row, tasks_dir_rel))
        return parts

    try:
        rows.sort(key=cmp_rows)
    except TypeError:
        rows.sort(key=lambda r: title_of(r, tasks_dir_rel))

    truncated = len(rows) > MAX_ROWS
    shown = rows[:MAX_ROWS]

    out_rows = []
    for row in shown:
        status_val = field(row, "status")
        st = statuses.get(status_val, {})
        prio_val = field(row, "priority")
        pr = priorities.get(prio_val, {})
        recurrence = field(row, "recurrence")
        complete_instances = field(row, "complete_instances") or []
        done_today = truthy(recurrence) and today_str() in [str(x) for x in complete_instances]
        is_done = bool(st.get("isCompleted")) if not truthy(recurrence) else done_today
        out_rows.append({
            "file": row["file"],
            "hash": row["hash"],
            "title": clip(title_of(row, tasks_dir_rel), MAX_TITLE),
            "status": clip(status_val),
            "statusLabel": clip(st.get("label") or status_val),
            "isCompleted": is_done,
            "priority": clip(prio_val),
            "priorityLabel": clip(pr.get("label") or prio_val),
            "due": clip(date_str(field(row, "due"))),
            "scheduled": clip(date_str(field(row, "scheduled"))),
            "recurring": truthy(recurrence),
        })

    print(json.dumps({"ok": True, "rows": out_rows, "truncated": truncated,
                       "total": len(rows)}))


def cmd_views(vault_path):
    settings = tasknotes_settings(vault_path)
    if settings is None:
        print(json.dumps({"ok": False, "error": "no-tasknotes"}))
        return
    views = list_base_views(vault_path) + list_saved_views(settings)
    # A view's id embeds its name and is written back as the viewId setting,
    # so an over-long one is dropped rather than clipped into an id that
    # would never match again.
    views = [v for v in views
             if len(v["name"]) <= MAX_VIEW_NAME and len(v["id"]) <= MAX_VIEW_NAME * 2][:MAX_VIEWS]
    print(json.dumps({"ok": True, "views": [
        {"id": v["id"], "name": v["name"], "source": clip(v["source"]),
         "supported": v["supported"], "reason": clip(v["reason"], MAX_TITLE)}
        for v in views
    ]}))


# ------------------------------------------------------------- API bonus ---

def api_base(settings):
    if not settings.get("enableAPI"):
        return None
    # data.json syncs with the vault, so the port is checked rather than
    # trusted: the auth token goes to it.
    port = settings.get("apiPort", 8080)
    if isinstance(port, bool) or not isinstance(port, (int, str)):
        return None
    try:
        port = int(port)
    except ValueError:
        return None
    if not 1 <= port <= 65535:
        return None
    return "http://127.0.0.1:%d" % port


def api_request(settings, method, path, payload=None):
    base = api_base(settings)
    if base is None:
        return None
    url = base + path
    data = json.dumps(payload).encode("utf-8") if payload is not None else None
    req = urllib.request.Request(url, data=data, method=method)
    req.add_header("Content-Type", "application/json")
    token = settings.get("apiAuthToken") or ""
    if token:
        req.add_header("Authorization", "Bearer " + token)
    try:
        with urllib.request.urlopen(req, timeout=API_TIMEOUT) as resp:
            body = resp.read(1 << 20)  # bound: never read an unbounded response
            return json.loads(body.decode("utf-8"))
    except Exception:
        return None  # any failure -> caller falls back to direct file write


def api_health_ok(settings):
    return api_request(settings, "GET", "/api/health") is not None


# ------------------------------------------------------------ mutations ----

def cmd_complete(vault_path, rel_path, expected_hash):
    _mutate(vault_path, rel_path, expected_hash, make_done=True)


def cmd_uncomplete(vault_path, rel_path, expected_hash, restore_mode, restore_value):
    _mutate(vault_path, rel_path, expected_hash, make_done=False,
             restore_mode=restore_mode, restore_value=restore_value)


def _mutate(vault_path, rel_path, expected_hash, make_done, restore_mode=None, restore_value=None):
    settings = tasknotes_settings(vault_path)
    if settings is None:
        print(json.dumps({"ok": False, "error": "no-tasknotes"}))
        return
    try:
        full = safe_join(vault_path, rel_path)
    except ValueError as e:
        print(json.dumps({"ok": False, "error": "bad-path", "message": str(e)}))
        return
    tasks_dir = safe_join(vault_path, settings.get("tasksFolder", "TaskNotes/Tasks"))
    if not full.startswith(tasks_dir + os.sep) and full != tasks_dir:
        print(json.dumps({"ok": False, "error": "out-of-scope",
                           "message": "refusing to write outside the configured tasks folder"}))
        return

    try:
        text = read_text(full)
    except OSError as e:
        print(json.dumps({"ok": False, "error": "read-failed", "message": str(e)}))
        return
    split = split_frontmatter(text)
    if not split:
        print(json.dumps({"ok": False, "error": "no-frontmatter"}))
        return
    fm_lines, body, fm_raw = split
    if fm_hash(fm_raw) != expected_hash:
        print(json.dumps({"ok": False, "error": "stale",
                           "message": "task changed on disk since it was scanned"}))
        return
    fm = parse_frontmatter(fm_lines)
    recurring = truthy(fm.get("recurrence"))
    blocks = field_blocks(fm_lines)
    prev_status = fm.get("status")

    api_ok = api_health_ok(settings)
    api_payload = {}

    # Mirrors what TaskNotes itself writes (see OmaForge docs/tasknotes-spec.md):
    # every write bumps dateModified; completing a non-repeating task stamps
    # completedDate; a repeating task completes its *current occurrence* and
    # moves on to the next one, its status untouched.
    today = today_str()
    if recurring:
        try:
            _rrule(str(fm.get("recurrence")), date.today())
        except Unsupported as e:
            print(json.dumps({"ok": False, "error": "unsupported-recurrence", "message": str(e)}))
            return
        before = {k: fm.get(k) for k in ("scheduled", "due", "complete_instances", "skipped_instances", "recurrence")}
        if make_done:
            completed = [date_str(x)[:10] for x in (fm.get("complete_instances") or [])]
            skipped = [date_str(x)[:10] for x in (fm.get("skipped_instances") or [])]
            scheduled = date_str(fm.get("scheduled"))
            due = date_str(fm.get("due"))
            anchor = "completion" if str(fm.get("recurrence_anchor") or "") == "completion" else "scheduled"
            fallback = parse_date(scheduled) or parse_date(fm.get("dateCreated"))
            rule = str(fm.get("recurrence"))
            target = today if anchor == "completion" else (scheduled[:10] or due[:10] or today)
            inst = recurring_instance(rule, target, completed, skipped, anchor, fallback)
            if inst in completed:
                completed.remove(inst)   # TaskNotes toggles an already-done occurrence
            else:
                completed = (completed + [inst])[-MAX_COMPLETE_INSTANCES:]
                skipped = [d for d in skipped if d != inst]
                if anchor == "completion":
                    # Completion-anchored: the rule restarts from when it was done.
                    m = DTSTART_RE.search(rule)
                    rule = (DTSTART_RE.sub("DTSTART:" + inst.replace("-", "") + m.group(1)[8:], rule, count=1)
                            if m else "DTSTART:%s;%s" % (inst.replace("-", ""), rule))
                    blocks = set_field(blocks, "recurrence", rule)
            blocks = set_field(blocks, "complete_instances", completed)
            blocks = set_field(blocks, "skipped_instances", skipped)
            suffix = scheduled[10:] if len(scheduled) > 10 else ""
            work_sched = scheduled if anchor == "completion" else inst + suffix
            nxt = next_open_occurrence(rule, max(today, inst), completed, skipped, anchor, fallback)
            if nxt:
                blocks = set_field(blocks, "scheduled", nxt + suffix)
                if due and work_sched and (settings.get("maintainDueDateOffsetInRecurring", False) or due[:10] < nxt):
                    try:
                        delta = date.fromisoformat(due[:10]) - date.fromisoformat(work_sched[:10])
                        blocks = set_field(blocks, "due", (date.fromisoformat(nxt) + delta).isoformat() + due[10:])
                    except ValueError:
                        pass
            # Undo restores exactly this state (TaskNotes' own un-complete
            # re-advances instead, which can't bring back an overdue date).
            new_result = {"restoreMode": "recurring",
                          "restoreValue": json.dumps({k: (v if not isinstance(v, (date, datetime)) else date_str(v))
                                                      if not isinstance(v, list) else [date_str(x) for x in v]
                                                      for k, v in before.items()})}
        else:
            try:
                prev = json.loads(restore_value) if restore_mode == "recurring" and restore_value else None
            except ValueError:
                prev = None
            if not isinstance(prev, dict):
                print(json.dumps({"ok": False, "error": "no-undo", "message": "nothing to restore"}))
                return
            for k in ("scheduled", "due", "complete_instances", "skipped_instances", "recurrence"):
                if k not in prev:
                    continue
                v = prev.get(k)
                blocks = remove_field(blocks, k) if v is None else set_field(blocks, k, v)
            new_result = {}
    else:
        if make_done:
            new_status = first_completed_status(settings)
            new_result = {"restoreMode": "status", "restoreValue": prev_status}
            blocks = set_field(blocks, "completedDate", today)
        else:
            new_status = restore_value if restore_value else first_open_status(settings)
            new_result = {}
            if not is_completed_status(settings, new_status):
                blocks = remove_field(blocks, "completedDate")
        blocks = set_field(blocks, "status", new_status)
        api_payload = {"status": new_status}
    blocks = set_field(blocks, "dateModified", now_ts())

    new_fm_text = blocks_to_text(blocks)
    new_text = "---\n" + new_fm_text + "\n---\n" + body

    try:
        atomic_write(full, new_text)
    except OSError as e:
        print(json.dumps({"ok": False, "error": "write-failed", "message": str(e)}))
        return

    if api_ok and api_payload:
        # Best-effort only: the file write above is already the source of
        # truth and has already succeeded: this just gives Obsidian's own
        # running instance a nudge via its own logic (e.g. auto-archive on
        # complete). A failure here is silently ignored.
        try:
            api_request(settings, "PUT", "/api/tasks/" + urllib.parse.quote(rel_path, safe=""),
                        api_payload)
        except Exception:
            pass

    final_text = read_text(full)
    final_split = split_frontmatter(final_text)
    new_hash = fm_hash(final_split[2]) if final_split else ""

    result = {"ok": True, "hash": new_hash}
    result.update(new_result)
    print(json.dumps(result))


def cmd_create(vault_path, title):
    settings = tasknotes_settings(vault_path)
    if settings is None:
        print(json.dumps({"ok": False, "error": "no-tasknotes"}))
        return
    tasks_dir_rel = settings.get("tasksFolder", "TaskNotes/Tasks")
    tasks_dir = safe_join(vault_path, tasks_dir_rel)
    try:
        os.makedirs(tasks_dir, exist_ok=True)
    except OSError as e:
        print(json.dumps({"ok": False, "error": "mkdir-failed", "message": str(e)}))
        return

    slug = re.sub(r"[^A-Za-z0-9]+", "-", title).strip("-").lower() or "task"
    slug = slug[:80]
    candidate = slug
    n = 1
    while os.path.exists(os.path.join(tasks_dir, candidate + ".md")):
        n += 1
        candidate = "%s-%d" % (slug, n)
    full = os.path.join(tasks_dir, candidate + ".md")

    tag = settings.get("taskTag", "todo")
    status = settings.get("defaultTaskStatus", "todo")
    priority = settings.get("defaultTaskPriority", "normal")
    # Match TaskNotes' own format: local time, 3 fractional digits, +HH:MM
    # offset (a bare isoformat() gives 6 digits and no offset, which
    # TaskNotes' strict datetime parser doesn't accept). TaskNotes also
    # always writes dateModified alongside dateCreated.
    now = datetime.now().astimezone().isoformat(timespec="milliseconds")
    fm = {
        "title": title,
        "status": status,
        "priority": priority,
        "tags": [tag],
        "dateCreated": now,
        "dateModified": now,
    }
    text = "---\n" + yaml.safe_dump(fm, sort_keys=False, allow_unicode=True) + "---\n"
    try:
        fd = os.open(full, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
    except OSError as e:
        print(json.dumps({"ok": False, "error": "write-failed", "message": str(e)}))
        return
    print(json.dumps({"ok": True, "file": os.path.relpath(full, vault_path)}))


# ------------------------------------------------------------------ main ---

def main(argv):
    if len(argv) < 2:
        eprint("usage: omatasknotes <vault|views|scan|complete|uncomplete|create> ...")
        return 2
    cmd = argv[1]
    signal.signal(signal.SIGALRM, _deadline)
    signal.alarm(DEADLINE_SEC)
    real_stdout, sys.stdout = sys.stdout, io.StringIO()
    try:
        return _run(cmd, argv)
    finally:
        signal.alarm(0)
        out, sys.stdout = sys.stdout.getvalue(), real_stdout
        if len(out.encode("utf-8")) > MAX_OUTPUT:
            out = json.dumps({"ok": False, "error": "too-large",
                              "message": "too much to show from this vault"}) + "\n"
        sys.stdout.write(out)


def _deadline(signum, frame):
    raise TimeoutError("took longer than %ds" % DEADLINE_SEC)


def _run(cmd, argv):
    # TimeoutError from the deadline lands in the last-resort guard below,
    # after atomic_write's own handler has removed any half-written temp file.
    try:
        if cmd == "vault":
            print(json.dumps(resolve_vault(argv[2] if len(argv) > 2 else "")))
        elif cmd == "views":
            cmd_views(expand(argv[2]))
        elif cmd == "scan":
            cmd_scan(expand(argv[2]), argv[3])
        elif cmd == "complete":
            cmd_complete(expand(argv[2]), argv[3], argv[4])
        elif cmd == "uncomplete":
            mode = argv[5] if len(argv) > 5 else ""
            value = argv[6] if len(argv) > 6 else ""
            cmd_uncomplete(expand(argv[2]), argv[3], argv[4], mode, value)
        elif cmd == "create":
            cmd_create(expand(argv[2]), argv[3])
        else:
            eprint("unknown command: %s" % cmd)
            return 2
    except Exception as e:  # last-resort guard: never let the widget hang on a crash
        print(json.dumps({"ok": False, "error": "internal", "message": str(e)}))
        return 0
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
